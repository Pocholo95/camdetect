[Unit]
Description=camdetect - app web de revision de rostros
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=camdetect
WorkingDirectory=/opt/camdetect
Environment=PYTHONPATH=/opt/camdetect/src
ExecStart=/opt/camdetect/venv/bin/python /opt/camdetect/src/review_app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
